{
  "item": [
    {
      "id": "73309875-88a1-4e7e-a2bc-ac93f21efd96",
      "name": "Payouts",
      "description": {
        "content": "The Payouts model will allow you to track funds you’ve received from SumUp.\n\nYou can receive a detailed payouts list with information like dates, fees, references and statuses, using the `List payouts` endpoint.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "6cef3db3-84f5-4313-bb0b-3251d0fc6728",
          "name": "List payouts",
          "request": {
            "name": "List payouts",
            "description": {
              "content": "Lists payout and payout-deduction records for the specified merchant account within the requested date range.\n\nThe response can include:\n- regular payouts (`type = PAYOUT`)\n- deduction records for refunds, chargebacks, direct debit returns, or balance adjustments\n\nResults are sorted by payout date in the requested `order`.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1.0",
                "merchants",
                ":merchant_code",
                "payouts"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "start_date",
                  "value": "<date>",
                  "description": "(Required) Start date of the payout period filter, inclusive, in [ISO8601](https://en.wikipedia.org/wiki/ISO_8601) `date` format (`YYYY-MM-DD`)."
                },
                {
                  "disabled": false,
                  "key": "end_date",
                  "value": "<date>",
                  "description": "(Required) End date of the payout period filter, inclusive, in [ISO8601](https://en.wikipedia.org/wiki/ISO_8601) `date` format (`YYYY-MM-DD`). Must be greater than or equal to `start_date`."
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "json",
                  "description": "Response format for the payout list."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Maximum number of payout records to return."
                },
                {
                  "disabled": false,
                  "key": "order",
                  "value": "asc",
                  "description": "Sort direction for the returned payouts."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "merchant_code",
                  "description": "(Required) Merchant code of the account whose payouts should be listed."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
          "response": [
            {
              "id": "7db95506-2377-4f5d-9828-246c1ab76147",
              "name": "Returns the list of payout and deduction records for the requested period.",
