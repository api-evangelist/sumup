          },
          "http": {
            "method": "GET",
            "url": "https://api.sumup.com/v0.1/merchants/:merchant_code/roles",
            "params": [
              {
                "name": "merchant_code",
                "value": "",
                "type": "path",
                "description": "Short unique identifier for the merchant."
              }
            ]
          },
          "docs": "List merchant's custom roles."
        },
        {
          "info": {
            "name": "Create a role",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.sumup.com/v0.1/merchants/:merchant_code/roles",
            "params": [
              {
                "name": "merchant_code",
                "value": "",
                "type": "path",
                "description": "Short unique identifier for the merchant."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a custom role for the merchant. Roles are defined by the set of permissions that they grant to the members that they are assigned to."
        },
        {
          "info": {
            "name": "Retrieve a role",
            "type": "http"
